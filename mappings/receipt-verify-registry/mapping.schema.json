{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TKCollective/tanilo-receipt-spec/mappings/receipt-verify-registry/mapping.schema.json",
  "title": "Vector -> requirement mapping (receipt-verify methodology §2.7)",
  "type": "object",
  "required": [
    "mapping_kind",
    "methodology",
    "corpus_snapshot",
    "coverage_rule",
    "cited_texts",
    "requirement_documents",
    "external_documents",
    "corpora",
    "reverse_view",
    "totals",
    "normative_audit"
  ],
  "properties": {
    "mapping_kind": {
      "const": "vector-requirement-mapping"
    },
    "methodology": {
      "type": "object",
      "required": [
        "name",
        "axis",
        "version",
        "url"
      ]
    },
    "corpus_snapshot": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "coverage_rule": {
      "type": "string"
    },
    "requirement_documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "scope",
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "external_documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "pinned",
          "note"
        ]
      }
    },
    "corpora": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "manifest",
          "manifest_sha256",
          "normative",
          "requirement_documents",
          "external_documents",
          "checkers",
          "vectors",
          "vector_count"
        ],
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vector_count": {
            "type": "integer",
            "minimum": 1
          },
          "vectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "requirement",
                      "coverage",
                      "checker",
                      "assertion"
                    ],
                    "properties": {
                      "coverage": {
                        "enum": [
                          "covered",
                          "partial",
                          "not covered"
                        ]
                      }
                    }
                  }
                },
                "external_requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "requirement",
                      "assertion"
                    ]
                  }
                },
                "status": {
                  "enum": [
                    "deferred"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": [
                    "requirements"
                  ],
                  "properties": {
                    "requirements": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "status": {
                      "const": "deferred"
                    },
                    "requirements": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "reverse_view": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "summary",
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "text",
                "coverage",
                "vectors"
              ],
              "properties": {
                "coverage": {
                  "enum": [
                    "covered",
                    "partial",
                    "not covered"
                  ]
                },
                "coverage_excluding_not_normative": {
                  "enum": [
                    "covered",
                    "partial",
                    "not covered"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "summary_excluding_not_normative": {
            "type": "object",
            "required": [
              "corpora",
              "requirements",
              "covered",
              "partial",
              "not_covered",
              "not_covered_list"
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "friday_priority",
        "also_accounted",
        "mapped_or_deferred",
        "deferred"
      ]
    },
    "cited_texts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "normative_audit": {
      "type": "object",
      "required": [
        "document",
        "source",
        "sections",
        "keywords",
        "rule",
        "summary",
        "sentences"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "sentences",
            "exercised",
            "unexercised"
          ]
        },
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "section",
              "text",
              "requirements",
              "exercised"
            ],
            "properties": {
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "exercised": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
